{
  "expo": {
    "name": "Hooked",
    "slug": "hooked-app",
    "version": "1.0.0",
    "scheme": "hooked",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0D0D"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D0D0D",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Dozvoli Hooked-u pristup lokaciji za GPS snimanje rute.",
          "locationAlwaysPermission": "Dozvoli Hooked-u pristup lokaciji u pozadini za kontinuirano snimanje ferate.",
          "locationWhenInUsePermission": "Dozvoli Hooked-u pristup lokaciji dok koristiš aplikaciju.",
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      "expo-task-manager"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "config": {
        "googleMapsApiKey": "AIzaSyAjTFmxkqP-ej7_JJMlSaEyJ9tNsFZfyvg"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0D0D0D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.anonymous.hookedapp",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAjTFmxkqP-ej7_JJMlSaEyJ9tNsFZfyvg"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
